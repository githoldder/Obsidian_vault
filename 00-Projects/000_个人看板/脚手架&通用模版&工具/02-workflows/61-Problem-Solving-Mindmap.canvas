		{"id":"7860adca38e3fe66","type":"file","file":"002_知识体系构建/001-如何学习一个陌生领域/长时记忆（LTM）.md","x":160,"y":-573,"width":250,"height":148},
		{"id":"6a00cfcb9e807e59","type":"text","text":"首先因为路径依赖","x":1420,"y":-15,"width":250,"height":60},
		{"id":"4d721f8f2232e83a","type":"text","text":"然而实际情况是大部分简单任务==距离目标太远，对达到目标帮助不大==，而最重要的任务往往**最困难**","x":1420,"y":118,"width":250,"height":113},
		{"id":"8fa7eef7a10eba22","type":"text","text":"1️⃣放弃","x":1420,"y":258,"width":250,"height":60,"color":"5"},
		{"id":"8d674ab801d519df","type":"text","text":"4️⃣切换任务","x":1420,"y":618,"width":250,"height":60,"color":"5"},
		{"id":"ccb4f048b223937a","type":"text","text":"2️⃣寻求外援","x":1420,"y":348,"width":250,"height":60,"color":"5"},
		{"id":"f0c953d01a7879d3","type":"text","text":"3️⃣死磕","x":1420,"y":438,"width":250,"height":60,"color":"5"},
