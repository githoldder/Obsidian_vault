<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:text="学生信息添加"
        android:textSize="22sp"
        android:textColor="#2669C6"
        android:gravity="center"
        android:paddingBottom="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:orientation="vertical"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content">

            <LinearLayout
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:text="学号"
                    android:textColor="#2669C6"
                    android:textSize="18sp"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content" />
                <EditText
                    android:id="@+id/etId"
                    android:hint="请输入学号"
                    android:inputType="number"
                    android:textColor="#000"
                    android:textSize="18sp"
                    android:background="@null"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:text="姓名"
                    android:textColor="#2669C6"
                    android:textSize="18sp"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content" />
                <EditText
                    android:id="@+id/etName"
                    android:hint="请输入姓名"
                    android:textColor="#000"
                    android:textSize="18sp"
                    android:background="@null"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:text="性别"
                    android:textColor="#2669C6"
                    android:textSize="18sp"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content" />
                <RadioGroup
                    android:id="@+id/rgGender"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <RadioButton
                        android:text="男"
                        android:checked="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                    <RadioButton
                        android:text="女"
                        android:layout_marginStart="20dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </RadioGroup>
            </LinearLayout>

            <LinearLayout
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:text="年龄"
                    android:textColor="#2669C6"
                    android:textSize="18sp"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content" />
                <EditText
                    android:id="@+id/etAge"
                    android:hint="16~30"
                    android:inputType="number"
                    android:textColor="#000"
                    android:textSize="18sp"
                    android:background="@null"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:text="班级"
                    android:textColor="#2669C6"
                    android:textSize="18sp"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content" />
                <EditText
                    android:id="@+id/etClazz"
                    android:hint="如23计一"
                    android:textColor="#000"
                    android:textSize="18sp"
                    android:background="@null"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginStart="10dp"
            android:layout_width="120dp"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/ivAddAvatar"
                android:scaleType="centerCrop"
                android:background="#DDD"
                android:layout_width="100dp"
                android:layout_height="120dp" />

            <Button
                android:id="@+id/btnSelectImage"
                android:text="选择图片"
                android:textColor="#2669C6"
                android:backgroundTint="#DDDDDD"
                android:padding="0dp"
                android:layout_marginTop="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:text="手机号"
            android:textColor="#2669C6"
            android:textSize="18sp"
            android:layout_width="85dp"
            android:layout_height="wrap_content" />
        <EditText
            android:id="@+id/etPhone"
            android:hint="11位数字"
            android:inputType="phone"
            android:textColor="#000"
            android:textSize="18sp"
            android:background="@null"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_marginBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:text="兴趣爱好"
            android:textColor="#2669C6"
            android:textSize="18sp"
            android:layout_width="85dp"
            android:layout_height="wrap_content" />
        <GridLayout
            android:id="@+id/glHobbies"
            android:columnCount="2"
            android:background="#F0F0F0"
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <CheckBox
                android:id="@+id/cbBasketball"
                android:text="篮球"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
            <CheckBox
                android:id="@+id/cbVolleyball"
                android:text="排球"
                android:layout_marginBottom="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
            <CheckBox
                android:id="@+id/cbBadminton"
                android:text="羽毛球"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
            <CheckBox
                android:id="@+id/cbTableTennis"
                android:text="乒乓球"
                android:layout_marginBottom="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
            <CheckBox
                android:id="@+id/cbSwimming"
                android:text="游泳"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
            <CheckBox
                android:id="@+id/cbReading"
                android:text="阅读"
                android:layout_marginBottom="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
            <CheckBox
                android:id="@+id/cbWriting"
                android:text="写作"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </GridLayout>
    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="25dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:text="家庭住址"
            android:textColor="#2669C6"
            android:textSize="18sp"
            android:layout_width="85dp"
            android:layout_height="wrap_content" />
        <EditText
            android:id="@+id/etAddress"
            android:hint="请输入住址"
            android:textColor="#000"
            android:textSize="18sp"
            android:background="@null"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/btnConfirm"
            android:text="确认"
            android:textSize="18sp"
            android:textColor="#000000"
            android:backgroundTint="#00BFFF"
            android:layout_marginEnd="30dp"
            android:layout_width="120dp"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btnCancel"
            android:text="取消"
            android:textSize="18sp"
            android:textColor="#000000"
            android:backgroundTint="#00BFFF"
            android:layout_width="120dp"
            android:layout_height="wrap_content" />

    </LinearLayout>

</LinearLayout>
