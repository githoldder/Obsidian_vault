	"nodes":[
		{"id":"915d970420650b86","type":"text","text":"# Done","x":-315,"y":240,"width":360,"height":60,"color":"4"},
		{"id":"6c10daa8d16fd121","type":"text","text":"#项目进行中 \n```dataview\nTABLE WITHOUT ID file.name AS \"项目名称\",\n参考链接 AS \"参考资料\"\nFROM \"010_时间管理/GTD管理模板工具/002_项目清单\"\nWHERE type = \"project\" AND 状态 = \"进行中\"\nSORT file.name ASC\n```\n\n\n #项目未开始\n```dataview\nLIST\nFROM \"010_时间管理/GTD管理模板工具/002_项目清单\"\nWHERE type = \"project\" AND 状态 = \"未开始\"\nSORT file.name ASC\n```\n#可能项目\n```dataview\nLIST\nFROM \"010_时间管理/GTD管理模板工具/001_可能清单\"\nWHERE type = \"possible\" AND 状态 = \"未计划\"\nSORT file.name ASC\n```","x":120,"y":-180,"width":380,"height":380},
		{"id":"629a2a52ccbf78af","type":"text","text":"## Check List","x":120,"y":240,"width":380,"height":60,"color":"1"},
		{"id":"a6624aa0e71149fb","type":"text","text":" #项目任务\n```dataview\nTASK\nFROM \"010_时间管理/GTD管理模板工具/002_项目清单\"\nWHERE !completed AND 状态 = \"进行中\"\nGROUP BY file.link\n```\n \n#daily-routine \n```dataview\nTASK\nWHERE contains(tags, \"#daily-routine\") AND contains(tags, \"#周六\")\n```\n\n#执行清单\n```dataview\ntask\nwhere type=\"todo\"\nand !completed\n```\n#等待清单 \n```dataview\nTASK\nFROM \"010_时间管理/GTD管理模板工具/003_等待清单\"\nWHERE !completed\nSORT created asc\n```\n","x":-315,"y":-180,"width":360,"height":380},
		{"id":"d3910599ca286a58","type":"text","text":"# TO DO","x":-315,"y":-250,"width":360,"height":60,"color":"6"},
		{"id":"88e0c56225f5fa8a","type":"text","text":"# Doing","x":120,"y":-250,"width":380,"height":60,"color":"3"},
		{"id":"d950b6b77da8a728","type":"text","text":"```dataview\nLIST\nFROM #GTD\nSORT file.path ASC\n```","x":120,"y":320,"width":380,"height":260},
		{"id":"af15ca2527a38066","type":"text","text":" #新增记录\n ==记录灵感或个人见解==\n [[Areas/010_时间管理/GTD管理模板工具/006_回收箱/006_回收箱]]\n\n#执行清单 \n```dataview\nTASK\nFROM \"010_时间管理/GTD管理模板工具\"\nWHERE completed AND date(completion) = date(2025-07-22)\nSORT completion desc\n```\n #已完成项目任务\n```dataview\nTASK\nFROM #project OR \"010_时间管理/GTD管理模板工具/002_项目清单\"\nWHERE completed\nGROUP BY file.link\n```\n\n #已取消\n```dataview\nTASK\nFROM \"010_时间管理/GTD管理模板工具/003_等待清单\"\nWHERE contains(tags, \"#已取消\")\n```","x":-315,"y":320,"width":360,"height":260}
