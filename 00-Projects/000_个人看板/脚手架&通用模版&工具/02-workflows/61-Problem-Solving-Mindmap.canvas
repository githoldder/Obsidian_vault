		{"id":"d2b13b10d1d2974d","type":"text","text":"最终摸索出一个陌生领域的认知地图","x":1417,"y":1276,"width":250,"height":60,"color":"1"},
		{"id":"388a5571276225fb","type":"text","text":"发散出去，找到","x":1417,"y":1042,"width":250,"height":60,"color":"3"},
		{"id":"ed23c91971aabb39","type":"text","text":"相关","x":1825,"y":1048,"width":250,"height":60,"color":"2"},
		{"id":"3cd76e0dcc6c915c","type":"text","text":"派生","x":1417,"y":1158,"width":250,"height":60,"color":"5"},
		{"id":"28e4daf3977fc1b3","type":"text","text":"1.缺乏时间管理，耗时两小时能量耗尽（任何生命活动包括思考任何东西，都会消耗能量）","x":1364,"y":1377,"width":303,"height":91},
		{"id":"6a6fe9e32087ef00","type":"text","text":"3.有信心为什么还是失败？","x":980,"y":1438,"width":250,"height":60,"color":"3"},
		{"id":"15065c7703809aaf","type":"text","text":"4.学习为什么会失焦？","x":980,"y":1618,"width":250,"height":60,"color":"2"},
		{"id":"ecd187c590f98c62","type":"text","text":"人的工作记忆能力极其有限，同时思考三件事情就会过载，==想在陌生邻域徜徉，一定不能让工作记忆被知识填满。==","x":1351,"y":1596,"width":449,"height":104},
		{"id":"97a00b92551077e2","type":"text","text":"2.缺乏策略、技巧，死磕教材；","x":1364,"y":1494,"width":303,"height":50},
		{"id":"1ae8423e17dcc536","type":"text","text":"系统一默认认为搞懂简单任务是理解困难任务的基础","x":1768,"y":-14,"width":250,"height":60},
		{"id":"6e6aa90eea3a7de6","type":"text","text":"并列组合","x":1120,"y":1043,"width":155,"height":59,"color":"4"},
		{"id":"f498f107e46bc623","type":"text","text":"1.任务太多，如何判断执行的优先级？","x":980,"y":45,"width":320,"height":60,"color":"6"},
		{"id":"267a12b6a3455c3c","type":"text","text":"找到问题的切入点，从这一关键概念出发","x":1419,"y":903,"width":250,"height":60,"color":"2"},
		{"id":"1979cd590d20a0ca","type":"text","text":"2.怎么执行困难任务？","x":980,"y":378,"width":250,"height":60,"color":"5"},
		{"id":"4959bd20520bb342","type":"text","text":"目标任务总有关键特征，与关键特征相关的就是突破口","x":1419,"y":770,"width":250,"height":68,"color":"1"},
		{"id":"bc440e8889dc9dd2","type":"text","text":"学习不是搞科研创新，一时找不到解决方案很正常，不如切换一个任务","x":1860,"y":426,"width":250,"height":84}
	],
