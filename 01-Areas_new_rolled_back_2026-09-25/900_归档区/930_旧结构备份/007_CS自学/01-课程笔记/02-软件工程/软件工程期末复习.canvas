		{"id":"a9c2d6826060be9e","x":1700,"y":-51,"width":250,"height":60,"type":"text","text":"软件配置管理"},
		{"id":"f9fd87690de8f11d","x":1700,"y":140,"width":250,"height":60,"type":"text","text":"基线"},
		{"id":"8e71f1bdd38317b2","x":1700,"y":360,"width":250,"height":60,"type":"text","text":"变化控制"},
		{"id":"14feb2c62609c70d","x":-1616,"y":-434,"width":250,"height":60,"type":"text","text":"提出关于问题性质、工程目标和规模的书面报告。"},
		{"id":"4447c8a18f8c401d","x":-1616,"y":-340,"width":250,"height":90,"type":"text","text":"确定是否存在可行的解决方案，用最小代价在最短时间内确定问题是否可解决"},
		{"id":"fd606d4d6f6a981a","x":-1616,"y":-227,"width":250,"height":95,"type":"text","text":"解决“目标系统必须做什么”，用正式文档（规格说明）准确记录需求"},
		{"id":"56f0cf5d9de72a00","x":-1616,"y":-117,"width":250,"height":89,"type":"text","text":"概括回答“怎样实现目标系统？”。包括模块化、设计几种可能方案、推荐最佳方案"},
		{"id":"f21c1d4483c6f859","x":-1616,"y":-13,"width":250,"height":90,"type":"text","text":"设计出程序的详细规格说明，确定每个模块所需的算法和数据结构"},
		{"id":"b9b08ff29ded7cec","x":-1616,"y":95,"width":250,"height":85,"type":"text","text":"写出正确的、易理解、易维护的程序模块，并仔细测试编写出的每个模块"},
		{"id":"f32393213aff5c82","x":-1616,"y":220,"width":250,"height":60,"type":"text","text":"通过集成测试和验收测试使软件达到预定要求。"},
		{"id":"bb6fbe5cdbe3199f","x":-1616,"y":331,"width":250,"height":99,"type":"text","text":"使系统持久地满足用户需要（包括改正性、适应性、完善性和预防性维护）。"}
	],
