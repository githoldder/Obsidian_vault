		{"id":"68c037c04a8534ed","type":"text","text":"```dataview\nTABLE WITHOUT ID \nfile.link AS \"项目名称\", \n状态 AS \"状态\",\n下一步 AS \"下一步\",\n参考链接 AS \"参考链接\" \nFROM \"010_时间管理/GTD管理模板工具/001_可能清单\" \nWHERE type = \"possible\" SORT file.name ASC\n```","x":-680,"y":327,"width":325,"height":413},
