		{"id":"85c1fb83bb4bf95b","type":"text","text":"Maven","x":689,"y":-600,"width":102,"height":60},
		{"id":"42e1569a03f4346a","type":"text","text":"Junit","x":689,"y":-511,"width":102,"height":60},
