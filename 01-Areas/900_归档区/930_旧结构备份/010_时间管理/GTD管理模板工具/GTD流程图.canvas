		{"id":"471b0fae5dad3ae7","type":"text","text":"### 执行(Engage)","x":-1280,"y":320,"width":250,"height":60,"color":"5"},
		{"id":"02d65f9632f163be","type":"text","text":"### 回顾","x":-1280,"y":150,"width":250,"height":60,"color":"6"},
		{"id":"842aec1aadcf7f89","type":"text","text":"### 组织","x":-1280,"y":-10,"width":250,"height":60,"color":"1"},
		{"id":"551a0ad3a6c29550","type":"text","text":"项目清单（Plan project）","x":250,"y":-1391,"width":250,"height":60,"color":"4"},
		{"id":"f04a3c359d064eea","type":"text","text":"等待清单（Waiting for task）","x":348,"y":-1065,"width":272,"height":65,"color":"4"},
		{"id":"cf666c1891e8a4b5","type":"text","text":"这件事情可行动吗","x":-148,"y":-1620,"width":209,"height":60,"color":"4"},
		{"id":"af55e109351b297d","type":"text","text":"收集箱(Inbox)","x":-128,"y":-1760,"width":168,"height":60,"color":"3"},
		{"id":"b39e9b34442d6e23","type":"text","text":"回收箱（Trash）","x":150,"y":-1532,"width":250,"height":60,"color":"4"},
		{"id":"1b168aae5a1581de","type":"text","text":"参考资料（Reference）即需要先进行调研","x":154,"y":-1706,"width":250,"height":60,"color":"2"},
		{"id":"ee223d8718ed69ce","type":"text","text":"这件事可以在2分钟内搞定吗？","x":-188,"y":-1220,"width":298,"height":55,"color":"5"},
		{"id":"944d0b224f6e087f","type":"text","text":"这件事可以一步搞定吗","x":-164,"y":-1389,"width":250,"height":60,"color":"3"},
		{"id":"02182ff012e2cc52","type":"text","text":"这件事该我做吗？","x":-163,"y":-1062,"width":250,"height":60,"color":"3"},
		{"id":"4fb55b3bf3ca0a1a","type":"text","text":"有特定时间吗？","x":-155,"y":-889,"width":250,"height":60,"color":"4"},
		{"id":"d13a215e06b41213","type":"text","text":"日历/应用","x":-155,"y":-695,"width":250,"height":60,"color":"1"},
		{"id":"83196cb9d821f70f","type":"text","text":"回收箱（Trash）","x":-85,"y":439,"width":250,"height":60,"color":"3"},
		{"id":"461cc715de775502","type":"text","text":"一切可被记录的，就可被参考","x":326,"y":439,"width":250,"height":50,"color":"3"},
		{"id":"531642dd02320eeb","type":"text","text":"日历/应用","x":-335,"y":600,"width":250,"height":60,"color":"4"},
		{"id":"2776503a7f5ea909","type":"text","text":"**①回归常识，避免追新、奇、怪**","x":620,"y":700,"width":250,"height":60,"color":"4"},
		{"id":"b13cfcdc2cd1ee72","type":"file","file":"010_时间管理/为什么说在GTD管理中切勿存机心.md","x":-914,"y":630,"width":400,"height":400,"color":"1"},
		{"id":"2699bfd0cb55703f","type":"text","text":"切勿**存机心**","x":-839,"y":380,"width":250,"height":50,"color":"6"},
		{"id":"a13968a43c8de07c","type":"text","text":"传统纸质工具","x":-839,"y":-10,"width":250,"height":60,"color":"3"},
		{"id":"003079bf03dd8ad0","type":"text","text":"分区","x":-639,"y":-331,"width":250,"height":60,"color":"1"},
		{"id":"2732a376118bfc10","type":"text","text":"执行清单","x":-85,"y":-391,"width":250,"height":60,"color":"2"},
		{"id":"2d6cca631f551985","type":"text","text":"等待清单","x":-85,"y":-301,"width":250,"height":60,"color":"3"},
		{"id":"187fce27e0132b90","type":"text","text":"项目清单（”Plan project“plan）","x":-85,"y":-227,"width":278,"height":50,"color":"4"},
		{"id":"5f86bc8c732ee489","type":"text","text":"可能清单（Someday/maybe）","x":-85,"y":-160,"width":278,"height":65,"color":"5"},
		{"id":"0855f0ae60da5db5","type":"text","text":"参考资料（Reference）","x":-39,"y":-10,"width":250,"height":60,"color":"2"},
		{"id":"59539f424e21d766","type":"text","text":"个人知识库","x":745,"y":-241,"width":250,"height":60,"color":"5"},
		{"id":"f26fc45380464ea1","type":"text","text":"网络搜索引擎","x":745,"y":50,"width":250,"height":53,"color":"4"},
		{"id":"5b44fd8f91e15e0b","type":"text","text":"现阶段工作所需参考资料","x":1260,"y":-331,"width":250,"height":60,"color":"2"},
		{"id":"ec0a17cf7d6593c2","type":"text","text":"智慧，或对智慧的见解","x":1260,"y":-127,"width":250,"height":60,"color":"6"},
		{"id":"35122d8369f3eeed","type":"text","text":"值得纪念、留存、回味、学习","x":1670,"y":-134,"width":301,"height":67,"color":"4"},
		{"id":"d923b90a571c64fd","type":"text","text":"**②提高信息的检索、辨别能力**","x":1170,"y":429,"width":250,"height":60,"color":"6"},
		{"id":"c7f0f8a2ae67bbc2","type":"text","text":"如何准备参考资料","x":680,"y":210,"width":250,"height":60,"color":"2"},
		{"id":"3e5b0796dd808354","type":"text","text":"**③提高参考资料的存档标准**","x":1010,"y":700,"width":250,"height":50,"color":"2"},
		{"id":"2eb96b10adaa5e54","type":"text","text":"搜索引擎能找到的，浅显平常的，不存档；","x":870,"y":856,"width":250,"height":60},
		{"id":"f97aafa79900ee81","type":"text","text":"新概念，但换汤不换药的，不存档","x":1170,"y":860,"width":250,"height":56},
		{"id":"92312f5cd338c51e","type":"text","text":"参考价值的高低是相对的","x":-15,"y":290,"width":250,"height":60,"color":"5"},
		{"id":"ae3bcd9b33e85deb","type":"text","text":"可能清单（Someday/maybe）==脱离当前实际情况,可行性评估不通过==","x":152,"y":-1634,"width":288,"height":89,"color":"1"},
		{"id":"5b33d27e8c2b5313","type":"text","text":"如何判断可行性?如何做可行性评估?","x":600,"y":-1619,"width":240,"height":60},
		{"id":"305a74964894d411","type":"text","text":"第一部分收录灵感,第二部分收录执行完的代办事项，第三部分放日历中的临时取消的活动、计划、会议","x":534,"y":-1532,"width":332,"height":92},
		{"id":"1c852b3f0f74b38c","type":"text","text":"绝大多数时候,项目清单内的事项都是要进行拆解的,因为我习惯性地不会把随手能做的小事放在待办,因此项目清单是重点","x":637,"y":-1395,"width":250,"height":155},
		{"id":"d47980a0579c9080","type":"text","text":"做完放回收箱","x":564,"y":-1218,"width":250,"height":60},
		{"id":"08eacca6e59a35ef","type":"text","text":"情景1:项目里的需要对接的部分,提交完自己负责的模块后向上级/组长发送汇报后,等待反馈","x":741,"y":-1131,"width":250,"height":99},
		{"id":"b1339f6d24a343c7","type":"text","text":"需要跨部门沟通/协调的,等待对方的反馈何回复","x":740,"y":-1009,"width":250,"height":60},
		{"id":"c12c56cc5f9986d2","type":"text","text":"其他场景:如排队、等消息回复、给下级布置任务后等待完成情况反馈","x":741,"y":-929,"width":250,"height":89},
		{"id":"1f9757501e6c4c26","type":"text","text":"这些等待清单的事项事实上也需要二次处理，即设置一个截止时间提醒、确认进度，==不是确认别人完成与否，而是确保任务顺利完成==","x":1109,"y":-1060,"width":250,"height":176},
		{"id":"9063a7fb4ad8c564","type":"text","text":"执行清单（@Context task）","x":300,"y":-740,"width":264,"height":60,"color":"2"},
		{"id":"3be3f01db0bf4593","type":"text","text":"没有特定的时间，即暂无截止日期，但是是有优先级的，遵循要事优先原则","x":720,"y":-807,"width":250,"height":97},
		{"id":"10bc917ca0fd6391","type":"text","text":"daily routine，也就是需要间隔重复的，设置专门的循环属性，从周计划中dataview，重点看属性：事项、标签、预估完成时间、外部链接（参考资料）==因为长期做的事情一般都需要规划何计划==","x":720,"y":-680,"width":271,"height":200},
		{"id":"ec964e7ba2ba0f2b","type":"text","text":"calender显示每月的固定routine完成情况或用于对照每天完成进度、追踪某类笔记完成频率，统计效率，用于反思记录某件事的完成效率、积极性、便于季复盘","x":-533,"y":-600,"width":250,"height":209},
		{"id":"9f4b8e5e4bc04812","type":"text","text":"立即做","x":320,"y":-1208,"width":128,"height":50,"color":"1"},
		{"id":"5d701a7e704eb2b2","type":"text","text":"不确定","x":948,"y":-1701,"width":250,"height":60},
		{"id":"bd4c424a1cff207d","type":"text","text":"只是临时起意，脑子一热","x":948,"y":-1618,"width":250,"height":60},
		{"id":"80fdf7737bd4cb53","type":"text","text":"没有计划，没做方案","x":955,"y":-1541,"width":250,"height":60},
		{"id":"35db2da909d9858d","type":"text","text":"项目清单整体的结构应该是什么样的,dataview提取信息,形成看板一定是需要筛选条件(属性)的,table表的筛选的表头应该设计成什么样子","x":1080,"y":-1280,"width":263,"height":161},
		{"id":"994968bc4432fad4","type":"text","text":"如何拆解任务,拆解标准是什么,拆解到什么程度可以变成最小可执行单元?","x":1080,"y":-1413,"width":250,"height":96},
		{"id":"fe4304c6052a5eca","type":"text","text":"像买猫粮这样的小事情。属性备注（今天必做或请求外援，即借助朋友的力量）、事项、预估时间即可","x":720,"y":-420,"width":300,"height":120},
		{"id":"ad0653e6ba4bd659","type":"text","text":"如何快速调研参考[[AI快速调研法]]","x":561,"y":-1779,"width":201,"height":73},
		{"id":"c2be8e5bbf85e799","type":"text","text":"每日TODO表，显示的字段包括：具体事项、预估时间、开始、截止时间、参考资料（外部链接）","x":-533,"y":-948,"width":250,"height":119},
		{"id":"88fb54df95c5eadd","type":"text","text":"设置每周重复提醒的事项、次数、复盘回顾时间，内部链接（即回顾用周plan,设置检查list，回到等待清单、项目清单、可能清单的事项思考下一步，转到执行清单链接，状态）","x":-600,"y":-820,"width":250,"height":220},
		{"id":"05a21423ebf2a544","type":"text","text":"可以一步搞定的程度即是最小单元","x":1438,"y":-1396,"width":322,"height":50},
		{"id":"b84cf2398856e8d7","type":"text","text":"项目名称,人员,下一步,参考链接,开始时间,截止时间,状态","x":1442,"y":-1235,"width":250,"height":75}
	],
