		{"id":"794ad1ca223ebb01","type":"text","text":"科目三正式考试流程（注意细节）","x":-580,"y":-400,"width":250,"height":60,"color":"#5a8ebf"},
		{"id":"2fd8e41a3b343bff","type":"text","text":"1.身份验证","x":-579,"y":-262,"width":250,"height":60,"color":"3"},
		{"id":"64ab45baaf0cf4c8","type":"text","text":"身份验证两步走，先关车门后验证","x":-170,"y":-261,"width":250,"height":60,"color":"3"},
		{"id":"4ea90602f3ef6f21","type":"text","text":"2.绕车检查","x":-579,"y":-130,"width":250,"height":60,"color":"2"},
		{"id":"7e747a7b43858007","type":"text","text":"绕车一周先尾后头，三灯点亮再回车内","x":-168,"y":-128,"width":250,"height":60,"color":"2"},
		{"id":"a867159a944e24ad","type":"text","text":"3.上车调整","x":-579,"y":6,"width":250,"height":60,"color":"1"},
		{"id":"2c1783d067427f8d","type":"text","text":"4.打火发动","x":-579,"y":133,"width":250,"height":60,"color":"5"},
		{"id":"7d3d380902dfc989","type":"text","text":"三板斧：踩离合，关钥匙，打火发动","x":-170,"y":135,"width":250,"height":60,"color":"5"},
		{"id":"c5f92be029a4b884","type":"text","text":"5.灯光考试","x":-578,"y":288,"width":250,"height":60,"color":"6"},
